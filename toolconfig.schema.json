{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "toolconfig.schema.json",
  "title": "superbash toolconfig",
  "description": "toolset の定義（.manifest/toolconfig.json）。設計 docs/superbash-design.md の 3 章。",
  "type": "object",
  "required": ["name", "tools", "commands"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "owner": { "type": "object", "properties": { "name": { "type": "string" } } },
    "tools": {
      "description": "key は tools/<name>/ の <name>（bin の名前にもなる）",
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/tool" }
    },
    "commands": { "type": "array", "items": { "$ref": "#/definitions/command" } }
  },
  "definitions": {
    "tool": {
      "type": "object",
      "required": ["entry"],
      "properties": {
        "entry": { "description": "tools/<name>/ からの相対 path の入口", "type": "string", "minLength": 1 },
        "module": { "description": "tools/<name>/ からの相対 path の module。読み込んでも走らず、main（citty の command）と run(rawArgs): Promise<number> を export する。あれば振り分けの file から呼ばれる（docs/toolset-convention.md 5.4）", "type": "string", "minLength": 1 },
        "sandbox": { "$ref": "#/definitions/sandbox" }
      }
    },
    "sandbox": {
      "description": "superbash --sandbox の時のこの tool の方針。絞るのは書き込みとネットワークだけ（読み取りは絞らない）。宛先・アドレスは書かない。項が無い tool の既定は network false、write は superbash の置き場と一時の dir だけ。docs/superbash-design.md の 2 章",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "write": {
          "description": "書き込みを許す path。`~`（home）・`$TMPDIR`・`.`（superbash の作業 dir）で始められる。それ以外は絶対 path",
          "type": "array",
          "items": { "type": "string", "pattern": "^(/|~(/|$)|\\$TMPDIR(/|$)|\\.(/|$))" }
        },
        "network": { "description": "外への通信を許すか（既定 false）", "type": "boolean" }
      }
    },
    "command": {
      "description": "上の要素（commands[] の 1 つ）。subcommands で下の要素を持てる（群）。葉は spec が必須、群は spec を省ける。docs/toolset-convention.md",
      "type": "object",
      "required": ["name", "tool"],
      "properties": {
        "name": { "description": "空白を含めない。並びの名前の先頭", "type": "string", "minLength": 1, "pattern": "^\\S+$" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "tool": { "description": "tools の key", "type": "string" },
        "version": { "type": "string" },
        "spec": { "$ref": "#/definitions/spec" },
        "subcommands": { "type": "array", "items": { "$ref": "#/definitions/subcommand" } }
      },
      "anyOf": [
        { "required": ["spec"] },
        { "required": ["subcommands"], "properties": { "subcommands": { "minItems": 1 } } }
      ]
    },
    "subcommand": {
      "description": "下の要素。command と同じ形（tool・category・version・spec.subcommand は上の要素だけ）。兄弟の name は重ならない",
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "description": "空白を含めない。argv の語にもなる", "type": "string", "minLength": 1, "pattern": "^\\S+$" },
        "description": { "type": "string" },
        "spec": { "$ref": "#/definitions/subspec" },
        "subcommands": { "type": "array", "items": { "$ref": "#/definitions/subcommand" } }
      },
      "anyOf": [
        { "required": ["spec"] },
        { "required": ["subcommands"], "properties": { "subcommands": { "minItems": 1 } } }
      ]
    },
    "subspec": {
      "description": "下の要素の spec（spec.subcommand は持てない）",
      "type": "object",
      "not": { "required": ["subcommand"] },
      "properties": {
        "usage": { "type": "string" },
        "in": { "$ref": "#/definitions/in" },
        "out": { "$ref": "#/definitions/out" }
      }
    },
    "spec": {
      "type": "object",
      "properties": {
        "subcommand": { "description": "bin の直後に付ける語（上の要素だけ。help は予約）", "type": "string" },
        "usage": { "type": "string" },
        "in": { "$ref": "#/definitions/in" },
        "out": { "$ref": "#/definitions/out" }
      }
    },
    "in": {
      "description": "wrapper は bin の後に spec.subcommand と下の名前の並び、options（書いた順）、`--`、positionals（書いた順）の順に argv を組む。args は呼ぶ葉の in だけで読む",
      "type": "object",
      "properties": {
        "options": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["flag", "type"],
            "properties": {
              "flag": { "description": "boolean は true の時だけ flag を出す。string・number は flag と値の 2 引数", "type": "string" },
              "type": { "enum": ["boolean", "string", "number"] },
              "description": { "type": "string" }
            }
          }
        },
        "positionals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string" },
              "type": { "enum": ["string", "number"] },
              "description": { "type": "string" },
              "optional": { "type": "boolean", "default": false }
            }
          }
        }
      }
    },
    "out": {
      "type": "object",
      "properties": {
        "stdout": {
          "type": "object",
          "properties": { "format": { "type": "string" }, "description": { "type": "string" } }
        },
        "stderr": { "type": "string" },
        "exitCodes": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  }
}
